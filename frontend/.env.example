NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sbp_your-publishable-key
NEXT_PUBLIC_API_BASE=https://your-function-url.lambda-url.us-east-1.on.aws
# Public origin of the deployed site. Used for canonical URLs, Open Graph tags
# and sitemap.xml — get it wrong and Facebook share cards break. Must be the
# apex domain, not the CloudFront domain: www and the *.cloudfront.net address
# both reach the site, but only this origin is in the API's CORS allow-list.
NEXT_PUBLIC_SITE_URL=https://whodoyause.com
# Optional — analytics no-ops if unset. From PostHog → Project settings.
NEXT_PUBLIC_POSTHOG_KEY=phc_your-project-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional — error reporting no-ops if unset. From Sentry -> Project settings -> Client keys.
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
